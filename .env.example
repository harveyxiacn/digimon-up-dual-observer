# Copy this file to .env. Keep the real Webhook private.
DIGIMON_DISCORD_WEBHOOK_URL=
# Runtime switches accept only true or false.
DIGIMON_AUTOMATION_ENABLED=true
DIGIMON_TASK_MONITORING_ENABLED=true
DIGIMON_EQUIPMENT_AUTOMATION_ENABLED=true
DIGIMON_FOOD_PROMPT_AUTOMATION_ENABLED=true
DIGIMON_DISCORD_NOTIFICATIONS_ENABLED=true
# zh_CN, zh_TW, en, or ja
DIGIMON_UI_LANGUAGE=zh_CN
